# EmailJS Configuration
# 1. Sign up or log in at https://www.emailjs.com/
# 2. Add an Email Service (e.g. Gmail) -> Copy your Service ID into VITE_EMAILJS_SERVICE_ID
# 3. Create an Email Template with variables: {{from_name}}, {{from_email}}, {{subject}}, {{message}}, {{to_email}} -> Copy your Template ID into VITE_EMAILJS_TEMPLATE_ID
# 4. Under Account > Public Key -> Copy into VITE_EMAILJS_PUBLIC_KEY

VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
